{
  "name": "typora-extensions",
  "private": true,
  "description": "Source of every extension in the Typora extension store, and the tooling that builds extensions.typora.io and themes.typora.io",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "permission-diff": "node scripts/permission-diff.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && node scripts/serve.mjs",
    "dev:themes": "node scripts/build.mjs --dev && node scripts/serve.mjs --site themes",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
