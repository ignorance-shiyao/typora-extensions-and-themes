{
  "name": "Monospace",
  "type": "dark",
  "colors": {
    "editor.background": "#263238",
    "editor.foreground": "#e9eded"
  },
  "tokenColors": [
    { "settings": { "foreground": "#e9eded" } },
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#546e7a" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#c3e88d" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#80cbc4" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#e9eded" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#ff5370" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["entity.name.function", "entity.name.class", "meta.definition"], "settings": { "foreground": "#e9eded" } },
    { "scope": ["support.function", "support.type", "support.class", "entity.name.type"], "settings": { "foreground": "#decb6b" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#f77669" } },
    { "scope": ["variable"], "settings": { "foreground": "#82b1ff" } },
    { "scope": ["variable.parameter", "variable.other.property", "support.variable.property"], "settings": { "foreground": "#80cbae" } },
    { "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#b6e6ff" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#b2b2e0" } }
  ]
}
