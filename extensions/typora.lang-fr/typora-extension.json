{
  "id": "typora.lang-fr",
  "name": "Français Language Pack",
  "version": "1.0.8",
  "description": "Shows Typora in French, and checks French spelling when the system spellchecker has no French dictionary.",
  "author": "Typora Team",
  "keywords": [
    "language pack",
    "translation",
    "French",
    "Français",
    "fr",
    "spelling",
    "dictionary"
  ],
  "tags": [
    "Language Pack"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "fr",
        "name": "Français",
        "englishName": "French",
        "path": "translations/fr.json"
      }
    ],
    "dictionaries": [
      {
        "language": "fr",
        "aff": "dictionaries/fr/index.aff",
        "dic": "dictionaries/fr/index.dic"
      }
    ]
  }
}
