{
  "id": "typora.lang-vi",
  "name": "Tiếng Việt Language Pack",
  "version": "1.0.8",
  "description": "Shows Typora in Vietnamese, and checks Vietnamese spelling when the system spellchecker has no Vietnamese dictionary.",
  "author": "Typora Team",
  "keywords": [
    "language pack",
    "translation",
    "Vietnamese",
    "Tiếng Việt",
    "vi",
    "spelling",
    "dictionary"
  ],
  "tags": [
    "Language Pack"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "vi",
        "name": "Tiếng Việt",
        "englishName": "Vietnamese",
        "path": "translations/vi.json"
      }
    ],
    "dictionaries": [
      {
        "language": "vi",
        "aff": "dictionaries/vi/index.aff",
        "dic": "dictionaries/vi/index.dic"
      }
    ]
  }
}
