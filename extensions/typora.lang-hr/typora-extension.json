{
  "id": "typora.lang-hr",
  "name": "Hrvatski Language Pack",
  "version": "1.0.2",
  "description": "Shows Typora in Croatian, and checks Croatian spelling when the system spellchecker has no Croatian dictionary.",
  "author": "Typora",
  "keywords": [
    "language pack",
    "translation",
    "Croatian",
    "Hrvatski",
    "hr",
    "spelling",
    "dictionary"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "hr",
        "name": "Hrvatski",
        "englishName": "Croatian",
        "path": "translations/hr.json"
      }
    ],
    "dictionaries": [
      {
        "language": "hr",
        "aff": "dictionaries/hr/index.aff",
        "dic": "dictionaries/hr/index.dic"
      }
    ]
  }
}
