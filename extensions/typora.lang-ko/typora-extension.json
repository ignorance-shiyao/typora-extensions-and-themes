{
  "id": "typora.lang-ko",
  "name": "한국어 Language Pack",
  "version": "1.0.7",
  "description": "Shows Typora in Korean, and checks Korean spelling when the system spellchecker has no Korean dictionary.",
  "author": "Typora Team",
  "keywords": [
    "language pack",
    "translation",
    "Korean",
    "한국어",
    "ko",
    "spelling",
    "dictionary"
  ],
  "tags": [
    "Language Pack"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "ko",
        "name": "한국어",
        "englishName": "Korean",
        "path": "translations/ko.json"
      }
    ],
    "dictionaries": [
      {
        "language": "ko",
        "aff": "dictionaries/ko/index.aff",
        "dic": "dictionaries/ko/index.dic"
      }
    ]
  }
}
