{
  "id": "typora.lang-sk",
  "name": "Slovenčina Language Pack",
  "version": "1.0.3",
  "description": "Shows Typora in Slovak, and checks Slovak spelling when the system spellchecker has no Slovak dictionary.",
  "author": "Typora",
  "keywords": [
    "language pack",
    "translation",
    "Slovak",
    "Slovenčina",
    "sk",
    "spelling",
    "dictionary"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "sk",
        "name": "Slovenčina",
        "englishName": "Slovak",
        "path": "translations/sk.json"
      }
    ],
    "dictionaries": [
      {
        "language": "sk",
        "aff": "dictionaries/sk/index.aff",
        "dic": "dictionaries/sk/index.dic"
      }
    ]
  }
}
