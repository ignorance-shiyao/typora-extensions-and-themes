{
  "id": "typora.lang-he",
  "name": "עברית Language Pack",
  "version": "1.0.6",
  "description": "Shows Typora in Hebrew, and checks Hebrew spelling when the system spellchecker has no Hebrew dictionary.",
  "author": "Typora",
  "keywords": [
    "language pack",
    "translation",
    "Hebrew",
    "עברית",
    "he",
    "spelling",
    "dictionary"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "he",
        "name": "עברית",
        "englishName": "Hebrew",
        "path": "translations/he.json"
      }
    ],
    "dictionaries": [
      {
        "language": "he",
        "aff": "dictionaries/he/index.aff",
        "dic": "dictionaries/he/index.dic"
      }
    ]
  }
}
