{
  "id": "typora.lang-sv",
  "name": "Svenska Language Pack",
  "version": "1.0.9",
  "description": "Shows Typora in Swedish, and checks Swedish spelling when the system spellchecker has no Swedish dictionary.",
  "author": "Typora Team",
  "keywords": [
    "language pack",
    "translation",
    "Swedish",
    "Svenska",
    "sv",
    "spelling",
    "dictionary"
  ],
  "tags": [
    "Language Pack"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "sv",
        "name": "Svenska",
        "englishName": "Swedish",
        "path": "translations/sv.json"
      }
    ],
    "dictionaries": [
      {
        "language": "sv",
        "aff": "dictionaries/sv/index.aff",
        "dic": "dictionaries/sv/index.dic"
      }
    ]
  }
}
