{
  "id": "typora.lang-da",
  "name": "Dansk Language Pack",
  "version": "1.0.0",
  "description": "Shows Typora in Danish, and checks Danish spelling when the system spellchecker has no Danish dictionary.",
  "author": "Typora",
  "keywords": [
    "language pack",
    "translation",
    "Danish",
    "Dansk",
    "da",
    "spelling",
    "dictionary"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "da",
        "name": "Dansk",
        "englishName": "Danish",
        "path": "translations/da.json"
      }
    ],
    "dictionaries": [
      {
        "language": "da",
        "aff": "dictionaries/da/index.aff",
        "dic": "dictionaries/da/index.dic"
      }
    ]
  }
}
