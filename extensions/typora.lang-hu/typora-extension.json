{
  "id": "typora.lang-hu",
  "name": "Magyar Language Pack",
  "version": "1.0.3",
  "description": "Shows Typora in Hungarian, and checks Hungarian spelling when the system spellchecker has no Hungarian dictionary.",
  "author": "Typora",
  "keywords": [
    "language pack",
    "translation",
    "Hungarian",
    "Magyar",
    "hu",
    "spelling",
    "dictionary"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "hu",
        "name": "Magyar",
        "englishName": "Hungarian",
        "path": "translations/hu.json"
      }
    ],
    "dictionaries": [
      {
        "language": "hu",
        "aff": "dictionaries/hu/index.aff",
        "dic": "dictionaries/hu/index.dic"
      }
    ]
  }
}
