{
  "id": "typora.lang-fa",
  "name": "فارسی Language Pack",
  "version": "1.0.0",
  "description": "Shows Typora in Persian, and checks Persian spelling when the system spellchecker has no Persian dictionary.",
  "author": "Typora",
  "keywords": [
    "language pack",
    "translation",
    "Persian",
    "فارسی",
    "fa",
    "spelling",
    "dictionary"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "fa",
        "name": "فارسی",
        "englishName": "Persian",
        "path": "translations/fa.json"
      }
    ],
    "dictionaries": [
      {
        "language": "fa",
        "aff": "dictionaries/fa/index.aff",
        "dic": "dictionaries/fa/index.dic"
      }
    ]
  }
}
