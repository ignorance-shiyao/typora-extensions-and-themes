{
  "id": "typora.lang-ca",
  "name": "Català Language Pack",
  "version": "1.0.7",
  "description": "Shows Typora in Catalan, and checks Catalan spelling when the system spellchecker has no Catalan dictionary.",
  "author": "Typora Team",
  "keywords": [
    "language pack",
    "translation",
    "Catalan",
    "Català",
    "ca",
    "spelling",
    "dictionary"
  ],
  "tags": [
    "Language Pack"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "ca",
        "name": "Català",
        "englishName": "Catalan",
        "path": "translations/ca.json"
      }
    ],
    "dictionaries": [
      {
        "language": "ca",
        "aff": "dictionaries/ca/index.aff",
        "dic": "dictionaries/ca/index.dic"
      }
    ]
  }
}
