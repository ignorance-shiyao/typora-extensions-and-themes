{
  "id": "typora.lang-el",
  "name": "Ελληνικά Language Pack",
  "version": "1.0.1",
  "description": "Shows Typora in Greek, and checks Greek spelling when the system spellchecker has no Greek dictionary.",
  "author": "Typora",
  "keywords": [
    "language pack",
    "translation",
    "Greek",
    "Ελληνικά",
    "el",
    "spelling",
    "dictionary"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "el",
        "name": "Ελληνικά",
        "englishName": "Greek",
        "path": "translations/el.json"
      }
    ],
    "dictionaries": [
      {
        "language": "el",
        "aff": "dictionaries/el/index.aff",
        "dic": "dictionaries/el/index.dic"
      }
    ]
  }
}
