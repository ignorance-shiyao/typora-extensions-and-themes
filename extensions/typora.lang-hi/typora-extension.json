{
  "id": "typora.lang-hi",
  "name": "हिन्दी Language Pack",
  "version": "1.0.9",
  "description": "Shows Typora in Hindi, and checks Hindi spelling when the system spellchecker has no Hindi dictionary.",
  "author": "Typora Team",
  "keywords": [
    "language pack",
    "translation",
    "Hindi",
    "हिन्दी",
    "hi",
    "spelling",
    "dictionary"
  ],
  "tags": [
    "Language Pack"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "hi",
        "name": "हिन्दी",
        "englishName": "Hindi",
        "path": "translations/hi.json"
      }
    ],
    "dictionaries": [
      {
        "language": "hi",
        "aff": "dictionaries/hi/index.aff",
        "dic": "dictionaries/hi/index.dic"
      }
    ]
  }
}
