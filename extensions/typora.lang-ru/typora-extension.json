{
  "id": "typora.lang-ru",
  "name": "Русский Language Pack",
  "version": "1.0.3",
  "description": "Shows Typora in Russian, and checks Russian spelling when the system spellchecker has no Russian dictionary.",
  "author": "Typora",
  "keywords": [
    "language pack",
    "translation",
    "Russian",
    "Русский",
    "ru",
    "spelling",
    "dictionary"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "ru",
        "name": "Русский",
        "englishName": "Russian",
        "path": "translations/ru.json"
      }
    ],
    "dictionaries": [
      {
        "language": "ru",
        "aff": "dictionaries/ru/index.aff",
        "dic": "dictionaries/ru/index.dic"
      }
    ]
  }
}
