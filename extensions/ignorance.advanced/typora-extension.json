      },
      {
        "id": "badge-close",
        "pattern": "(?<=\\(\\((?:blue|green|orange|red|purple|amber|gray):[^()\\n]+)\\)\\)",
        "class": "ib-syn"
      },
      {
        "id": "spoiler-open",
        "pattern": "\\(\\(spoiler:(?=[^()\\n]+\\)\\))",
        "class": "ib-syn"
      },
      {
        "id": "spoiler",
        "pattern": "(?<=\\(\\(spoiler:)[^()\\n]+(?=\\)\\))",
        "class": "ib-spoiler",
        "title": "悬停查看"
      },
      {
        "id": "spoiler-close",
        "pattern": "(?<=\\(\\(spoiler:[^()\\n]+)\\)\\)",
        "class": "ib-syn"
      },
      {
        "id": "ruby-open",
        "pattern": "\\(\\(ruby:(?=[^()|\\n]+\\|[^()\\n]+\\)\\))",
        "class": "ib-syn"
      },
      {
        "id": "ruby",
        "pattern": "(?<=\\(\\(ruby:)[^()|\\n]+?(?=\\s*\\|\\s*([^()\\n]+)\\)\\))",
        "class": "ib-ruby",
        "title": "$1"
      },
      {
        "id": "ruby-close",
        "pattern": "(?<=\\(\\(ruby:[^()|\\n]+?)\\s*\\|[^()\\n]+\\)\\)",
        "class": "ib-syn"
      },
      {
        "id": "crumb-open",
        "pattern": "\\(\\(crumb:(?=[^()\\n]+\\)\\))",
        "class": "ib-syn"
      },
      {
        "id": "crumb",
        "pattern": "(?<=\\(\\(crumb:)([^()\\n]+)(?=\\)\\))",
        "class": "ib-crumb",
        "title": "$1"
      },
      {
        "id": "crumb-close",
        "pattern": "(?<=\\(\\(crumb:[^()\\n]+)\\)\\)",
        "class": "ib-syn"
      },
      {
        "id": "hl-red",
        "pattern": "🔴[^=\\s，。、；：！？,.;:!?]+",
