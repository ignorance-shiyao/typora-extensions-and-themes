    "configuration": {
      "title": "Ignorance Advanced",
      "properties": {
        "dateFormat": {
          "type": "string",
          "title": "插入日期格式",
          "enum": ["iso", "weekday", "wiki"],
          "enumLabels": ["日期", "日期和星期", "Wiki 链接"],
          "default": "iso"
        },
        "dateWeekStart": {
          "type": "number",
          "title": "每周起始日",
          "enum": [1, 0],
          "enumLabels": ["周一", "周日"],
          "default": 1
        },
        "showMascot": {
          "type": "boolean",
          "default": false,
          "title": "在演示里显示双猫",
          "description": "封面右下角和最后一页。主题里的双猫在 设置 ▸ 视图 ▸ 主题选项「双猫」单独开关，默认都关闭。"
        },
        "lintHeadings": {
          "type": "boolean",
          "default": true,
          "title": "整理标题层级与空行"
        },
        "lintBullets": {
          "type": "boolean",
          "default": true,
          "title": "列表符号统一"
        },
        "lintNumbering": {
          "type": "boolean",
          "default": true,
          "title": "有序列表重新编号"
        },
        "lintBlankLines": {
          "type": "boolean",
          "default": true,
          "title": "合并连续空行"
        },
        "lintTrailingSpaces": {
          "type": "boolean",
          "default": true,
          "title": "删除行尾空白"
        },
        "lintHardBreaks": {
          "type": "boolean",
          "default": true,
          "title": "保留 Markdown 硬换行",
          "when": {
            "lintTrailingSpaces": true
          }
        },
        "lintFinalNewline": {
          "type": "boolean",
          "default": true,
          "title": "文件末尾保留一个换行"
        },
        "lintPunctuation": {
          "type": "boolean",
          "default": true,
          "title": "中文标点全角化"
        },
        "lintCjkSpacing": {
          "type": "boolean",
          "default": true,
          "title": "中英文之间加空格"
        },
        "lintEmphasis": {
          "type": "boolean",
          "default": true,
          "title": "统一斜体标记"
        },
        "lintIndent": {
          "type": "number",
          "default": 2,
          "enum": [
            0,
            2,
            4
          ],
          "enumLabels": [
