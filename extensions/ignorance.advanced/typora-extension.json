{
  "id": "ignorance.advanced",
  "name": "Ignorance Advanced",
  "version": "0.1.0",
  "description": "演示模式（内置图表与流程图）、行内徽章与彩色高亮、图表索引侧栏、中英文空格格式化。",
  "author": "ignorance-shiyao",
  "repository": "https://github.com/ignorance-shiyao/ignorance-for-typora",
  "engines": {
    "typora": ">=2.0.0"
  },
  "keywords": [
    "slides",
    "presentation",
    "cjk",
    "chinese",
    "badge",
    "template"
  ],
  "tags": [
    "Markdown Extension",
    "Detail View",
    "Writing"
  ],
  "main": "main.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:date-insert",
    "onCommand:date-convert",
    "onCommand:outline-up",
    "onCommand:outline-down",
    "onCommand:outline-promote",
    "onCommand:outline-demote",
    "onCommand:outline-branch",
    "onCommand:outline-depth",
    "onCommand:outline-to-list",
    "onCommand:outline-to-headings",
    "onCommand:table-sort-asc",
    "onCommand:table-sort-desc",
    "onCommand:table-recalculate",
    "onCommand:table-total",
    "onCommand:table-transpose",
    "onCommand:table-csv-convert"
  ],
  "contributes": {
    "commands": [
      {"id": "date-insert", "title": "插入自然语言日期", "category": "日期"},
      {"id": "date-convert", "title": "将选中文字转换为日期", "category": "日期"},
      {"id": "outline-up", "title": "上移列表项", "category": "列表"},
      {"id": "outline-down", "title": "下移列表项", "category": "列表"},
      {"id": "outline-promote", "title": "提升列表层级", "category": "列表"},
      {"id": "outline-demote", "title": "降低列表层级", "category": "列表"},
      {"id": "outline-branch", "title": "查看列表分支", "category": "列表"},
      {"id": "outline-depth", "title": "查看列表前几层", "category": "列表"},
      {"id": "outline-to-list", "title": "将选中文本转换为列表", "category": "列表"},
      {"id": "outline-to-headings", "title": "将选中列表转换为标题", "category": "列表"},
      {
        "id": "table-sort-asc",
        "title": "按列升序排序",
        "category": "表格"
      },
      {
        "id": "table-sort-desc",
        "title": "按列降序排序",
        "category": "表格"
      },
      {
        "id": "table-recalculate",
        "title": "重新计算表格",
        "category": "表格"
      },
      {
        "id": "table-total",
        "title": "追加合计行",
        "category": "表格"
      },
      {
        "id": "table-transpose",
        "title": "转置表格",
        "category": "表格"
      },
      {
        "id": "table-csv-convert",
        "title": "将选中的 CSV 转为表格",
        "category": "表格"
      }
    ],
    "keyBindings": [
      {"command": "outline-up", "key": "Mod+Shift+F7"},
      {"command": "outline-down", "key": "Mod+Shift+F8"},
      {"command": "outline-promote", "key": "Mod+Shift+F9"},
      {"command": "outline-demote", "key": "Mod+Shift+F10"}
    ],
    "menus": {
      "editor/context": [
        {"command": "date-convert", "when": "editorHasSelection"},
        {
          "command": "table-sort-asc",
          "when": "blockType == 'table_cell'"
        },
        {
          "command": "table-sort-desc",
          "when": "blockType == 'table_cell'"
        },
        {
          "command": "table-recalculate",
          "when": "blockType == 'table_cell'"
        },
        {
          "command": "table-total",
          "when": "blockType == 'table_cell'"
        },
        {
          "command": "table-transpose",
          "when": "blockType == 'table_cell'"
        }
      ],
      "inlinePalette": [
        {"command": "date-insert"},
        {
          "command": "table-sort-asc",
          "when": "blockType == 'table_cell'"
        },
        {
          "command": "table-sort-desc",
          "when": "blockType == 'table_cell'"
        },
        {
          "command": "table-recalculate",
          "when": "blockType == 'table_cell'"
        },
        {
          "command": "table-total",
          "when": "blockType == 'table_cell'"
        },
        {
          "command": "table-transpose",
          "when": "blockType == 'table_cell'"
        }
      ]
    },
    "inlineRules": [
      {
        "id": "badge-open",
        "pattern": "\\(\\((?:blue|green|orange|red|purple|amber|gray):(?=[^()\\n]+\\)\\))",
        "class": "ib-syn"
      },
      {
        "id": "badge-blue",
        "pattern": "(?<=\\(\\(blue:)([^()|\\n]+?)\\s*\\|\\s*([^()\\n]*[^()\\s])(?=\\)\\))",
        "class": "ib-badge ib-badge-blue",
        "title": "$1 · $2"
      },
      {
        "id": "badge-green",
        "pattern": "(?<=\\(\\(green:)([^()|\\n]+?)\\s*\\|\\s*([^()\\n]*[^()\\s])(?=\\)\\))",
        "class": "ib-badge ib-badge-green",
        "title": "$1 · $2"
      },
      {
        "id": "badge-orange",
