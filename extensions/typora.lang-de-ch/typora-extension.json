{
  "id": "typora.lang-de-ch",
  "name": "Deutsch (Schweiz) Language Pack",
  "version": "1.0.5",
  "description": "Shows Typora in German (Switzerland), and checks German (Switzerland) spelling when the system spellchecker has no German (Switzerland) dictionary.",
  "author": "Typora",
  "keywords": [
    "language pack",
    "translation",
    "German (Switzerland)",
    "Deutsch (Schweiz)",
    "de-CH",
    "spelling",
    "dictionary"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "de-CH",
        "name": "Deutsch (Schweiz)",
        "englishName": "German (Switzerland)",
        "path": "translations/de-CH.json"
      }
    ],
    "dictionaries": [
      {
        "language": "de-CH",
        "aff": "dictionaries/de-CH/index.aff",
        "dic": "dictionaries/de-CH/index.dic"
      }
    ]
  }
}
