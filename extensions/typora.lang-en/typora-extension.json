{
  "id": "typora.lang-en",
  "name": "English Spelling Dictionaries",
  "version": "1.0.1",
  "description": "Checks English (US and UK) spelling when the system has no spellchecker or no English dictionary, as on Linux.",
  "author": "Typora Team",
  "keywords": [
    "language pack",
    "spelling",
    "dictionary",
    "English",
    "en"
  ],
  "tags": [
    "Language Pack"
  ],
  "contributes": {
    "dictionaries": [
      {
        "language": "en-US",
        "aff": "dictionaries/en-US/index.aff",
        "dic": "dictionaries/en-US/index.dic"
      },
      {
        "language": "en-GB",
        "aff": "dictionaries/en-GB/index.aff",
        "dic": "dictionaries/en-GB/index.dic"
      }
    ]
  }
}
