{
  "id": "typora.lang-uk",
  "name": "Українська Language Pack",
  "version": "1.0.3",
  "description": "Shows Typora in Ukrainian, and checks Ukrainian spelling when the system spellchecker has no Ukrainian dictionary.",
  "author": "Typora",
  "keywords": [
    "language pack",
    "translation",
    "Ukrainian",
    "Українська",
    "uk",
    "spelling",
    "dictionary"
  ],
  "contributes": {
    "localizations": [
      {
        "locale": "uk",
        "name": "Українська",
        "englishName": "Ukrainian",
        "path": "translations/uk.json"
      }
    ],
    "dictionaries": [
      {
        "language": "uk",
        "aff": "dictionaries/uk/index.aff",
        "dic": "dictionaries/uk/index.dic"
      }
    ]
  }
}
